TRACKER_API_URL=https://hotel-review-tracker-api-gbp.onrender.com
OTA_WORKER_SECRET=
OTA_INTERVAL_MINUTES=60
OTA_EVIDENCE_DIR=./evidence
# Optional normalized API or email feeds; configure only approved sources.
OTA_FEED_ALLOWED_HOSTS=
OTA_AGODA_API_URL=
OTA_AGODA_API_TOKEN=
OTA_TRAVELOKA_API_URL=
OTA_TRAVELOKA_API_TOKEN=
OTA_TRIP_API_URL=
OTA_TRIP_API_TOKEN=
OTA_AGODA_EMAIL_URL=
OTA_TRAVELOKA_EMAIL_URL=
OTA_TRIP_EMAIL_URL=
GOOGLE_MAPS_PROFILE_DIR=
GOOGLE_MAPS_HEADLESS=false
OTA_BROWSER_HEADLESS=false
# Optional local profile for Agoda Partner Portal (YCS); keep it out of Git.
# Default: worker/ycs-profile/, independent of the current working directory.
AGODA_YCS_PROFILE_DIR=
# IDs with YCS access, for example 83491477. Opt-in; no automatic enrollment.
AGODA_YCS_PROPERTY_IDS=
# When true, the main daemon reads those Agoda properties through signed-in YCS.
# Their public Agoda scans are skipped so they cannot overwrite YCS statistics.
# Keep false to track the Agoda-native score/count that guests see publicly.
AGODA_YCS_ENABLED=false
# Booking remains opt-in until signed-in identity and the backend migration are verified.
BOOKING_EXTRANET_ENABLED=false
BOOKING_EXTRANET_PROPERTY_IDS=
